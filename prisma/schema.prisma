// ============================================================================
// PLUGGED. — Database schema
// ----------------------------------------------------------------------------
// Better Auth manages `User`, `Session`, `Account`, and `Verification`.
// Their column shapes are dictated by the Better Auth Prisma adapter spec:
// https://www.better-auth.com/docs/adapters/prisma
//
// IMPORTANT: Better Auth generates its own IDs, so `User`/`Session`/`Account`/
// `Verification` intentionally have NO `@default(...)` on their `id` fields.
//
// `Purchase` is application-owned: it records which bundle a user has bought
// and is the single source of truth for the dashboard "vault".
//
// NOTE: This sandbox runs SQLite. The exact same schema works against Neon
// (Postgres) by flipping `provider = "sqlite"` → `"postgresql"` and pointing
// `DATABASE_URL` at the Neon connection string — no model changes required.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ------------------------------------------------------------------- Better Auth
model User {
  id            String     @id
  email         String     @unique
  emailVerified Boolean    @default(false)
  name          String
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  purchases     Purchase[]
  reviews       Review[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime  @updatedAt
}

// ------------------------------------------------------------ Application: vault
model Purchase {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Slug matching a Product id in lib/products.ts (y2k | opium | vintage | designer)
  bundleId                String
  bundleName              String?
  /// Price paid in USD cents at time of purchase.
  amount                  Int
  /// Stripe checkout session id (when paid via Stripe). Null for voucher unlocks.
  stripeCheckoutSessionId String?
  createdAt               DateTime @default(now())

  /// A user can own a given bundle exactly once.
  @@unique([userId, bundleId])
  @@index([userId])
}

// ----------------------------------------------------------- Application: support
model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  userId    String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ----------------------------------------------------------- Application: vouchers
/// Promotional codes redeemable at checkout. A 100%-off voucher bypasses
/// Stripe entirely (the bundle is granted directly). Partial discounts
/// flow through Stripe via a dynamically created one-time coupon.
model Voucher {
  id              String              @id @default(cuid())
  /// Case-insensitive code the user types in at checkout. Stored uppercase.
  code            String              @unique
  /// Whole-number percentage off, 1–100. 100 = full bypass / free unlock.
  /// May be 0 when the discount is a fixed amount (see discountAmountCents).
  discountPercent Int
  /// Optional fixed amount off in EUR cents (e.g. 200 = €2). Used by the
  /// "leave a review, get €2 off" reward. Null = percentage voucher.
  discountAmountCents Int?
  /// Optional cap on total uses across all users. Null = unlimited.
  maxUses         Int?
  /// How many times this voucher has been redeemed.
  usedCount       Int                 @default(0)
  /// Optional expiry. Null = never expires.
  expiresAt       DateTime?
  /// Optional human-friendly note (audit / admin).
  note            String?
  createdAt       DateTime            @default(now())
  redemptions     VoucherRedemption[]

  @@index([code])
}

/// Audit log of every voucher redemption — also enforces "one voucher per user per bundle"
/// indirectly (the cart only allows one voucher and bundles are unique per user).
model VoucherRedemption {
  id        String   @id @default(cuid())
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId    String
  bundleId  String
  /// Percent applied at the time of redemption (snapshot in case the voucher changes later).
  percent   Int
  createdAt DateTime @default(now())

  @@index([voucherId])
  @@index([userId])
}

/// Internal supplier / batch reviews left by buyers inside their vault.
/// Gated: a user can only read or write reviews for a bundle they OWN
/// (enforced in the API against the `Purchase` table). One review per user
/// per bundle. Leaving a review grants a one-time €2-off reward voucher.
model Review {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundleId   String
  /// Optional supplier this review is about (from the bundle's supplier list).
  supplier   String?
  /// 1–5 star rating for the batch / supplier quality.
  rating     Int
  comment    String
  /// Display name snapshot at time of writing.
  authorName String
  /// The reward voucher code granted for this review (null if none granted).
  rewardCode String?
  createdAt  DateTime @default(now())

  @@unique([userId, bundleId])
  @@index([bundleId])
  @@index([userId])
}
