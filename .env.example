# =============================================================================
# PLUGGED. — Environment variables
# Copy to `.env.local` for local development.
# Prisma CLI (`npm run db:push`) also reads `.env.local` via dotenv-cli.
# On Vercel: set these in Project Settings → Environment Variables.
# =============================================================================

# --- Database (Neon Postgres) ---
# Pooled connection string (runtime queries)
DATABASE_URL="postgresql://..."
# Direct connection (Prisma migrations / db push)
DATABASE_URL_UNPOOLED="postgresql://..."

# --- Better Auth ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Local dev only; Vercel derives the public URL from each request
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-host>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stripe (real checkout mode) ---
# When STRIPE_SECRET_KEY is set, checkout uses Stripe Checkout Sessions.
# Leave unset to use demo mode (instant bundle grant, no payment).
# Set DEMO_CHECKOUT=true to force demo mode even when Stripe keys exist (testing).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
DEMO_CHECKOUT=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (Resend — password reset + support notifications) ---
# https://resend.com — free tier works for MVP
RESEND_API_KEY=""
# Must be a verified domain in Resend (or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL="PLUGGED <onboarding@resend.dev>"
# Where support form submissions are forwarded (optional; tickets always saved in DB)
SUPPORT_INBOX="plugged.support@gmail.com"

# =============================================================================
# Stripe webhook setup (production)
# 1. Stripe Dashboard → Developers → Webhooks → Add endpoint
# 2. URL: https://<your-domain>/api/webhook
# 3. Event: checkout.session.completed
# 4. Copy the signing secret into STRIPE_WEBHOOK_SECRET
#
# Local webhook testing:
#   stripe listen --forward-to localhost:3000/api/webhook
# =============================================================================
